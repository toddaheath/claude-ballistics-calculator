FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY BallisticsCalculator.sln ./
COPY src/BallisticsCalculator.Core/BallisticsCalculator.Core.csproj src/BallisticsCalculator.Core/
COPY src/BallisticsCalculator.Infrastructure/BallisticsCalculator.Infrastructure.csproj src/BallisticsCalculator.Infrastructure/
COPY src/BallisticsCalculator.Api/BallisticsCalculator.Api.csproj src/BallisticsCalculator.Api/
COPY tests/BallisticsCalculator.Core.Tests/BallisticsCalculator.Core.Tests.csproj tests/BallisticsCalculator.Core.Tests/
COPY tests/BallisticsCalculator.Api.Tests/BallisticsCalculator.Api.Tests.csproj tests/BallisticsCalculator.Api.Tests/
RUN dotnet restore src/BallisticsCalculator.Api/BallisticsCalculator.Api.csproj

COPY src/ src/
RUN dotnet publish src/BallisticsCalculator.Api/BallisticsCalculator.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime
WORKDIR /app

# .NET 8 Alpine images include a non-root 'app' user at UID/GID 1654
USER 1654

COPY --from=build /app .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "BallisticsCalculator.Api.dll"]
